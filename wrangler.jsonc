{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 앱(정적 파일) — Workers 정적 에셋 호스팅. 배포: npm run deploy
  "name": "ganpanda",
  "compatibility_date": "2026-10-01",
  // 도메인 전파 전·비상용으로 workers.dev 주소도 유지
  "workers_dev": true,
  // 정적 에셋 앞의 작은 워커: 없는 /assets·/env 경로가 index.html(200, 1년 캐시)로 내려와 휴대폰이 깨지던 문제 → 404 (2026-10-21, worker/guard.ts)
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 모든 경로를 index.html 로 (?room= 같은 쿼리 포함 단일 페이지 앱)
    "not_found_handling": "single-page-application",
    // 모든 경로가 워커를 먼저 거친다 — 서비스 차단(SERVICE_BLOCKED)을 모든 페이지에 걸기 위해 (2026-10-31; 전에는 /assets·/env 만)
    "run_worker_first": ["/*"]
  },
  // 서비스 차단 (2026-10-31 법적 문제): "1" 이면 모든 페이지에 안내만(503). 해제 = "" 로 바꿔 배포
  "vars": { "SERVICE_BLOCKED": "1" },
  "routes": [
    { "pattern": "ganpanda.co.kr", "custom_domain": true },
    { "pattern": "www.ganpanda.co.kr", "custom_domain": true }
  ]
}
