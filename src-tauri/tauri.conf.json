{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "간판다",
  "version": "0.1.0",
  "identifier": "kr.co.ganpanda.app",
  "build": {
    "frontendDist": "https://ganpanda.co.kr",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --port 5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["ganpanda"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "간판다",
    "longDescription": "건물 사진 위에서 사인물을 함께 정하고 견적까지",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
