{
  "name": "ganpanda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check && vite build && node scripts/strip-ort.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "svelte-check",
    "deploy": "npm run build && wrangler deploy && node scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "app:dev": "cargo tauri dev",
    "app:live": "cargo tauri dev --config src-tauri/tauri.live.json",
    "app:build": "cargo tauri build",
    "app:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "app:ios": "cargo tauri ios dev",
    "app:android": "cargo tauri android dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0",
    "write-excel-file": "^4.1.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "^6.4.299",
    "pretendard": "^1.3.9",
    "read-excel-file": "^9.3.12",
    "three": "^0.186.1",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  }
}
