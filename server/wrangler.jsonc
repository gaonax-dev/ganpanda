{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ganpanda-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // 도메인 전파 전·비상용으로 workers.dev 주소도 유지
  "workers_dev": true,
  "routes": [{ "pattern": "sync.ganpanda.co.kr", "custom_domain": true }],
  // 프로젝트(방) 하나 = Durable Object 하나: Yjs 문서 보관 + WebSocket 중계 (Hibernation)
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      // 계정마다 하나: 동시접속 좌석 계산 (1-2c)
      { "name": "ACCOUNT", "class_name": "Account" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Account"] }
  ],
  // 사진·디자인 파일 (내용 해시 = 키)
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "ganpanda-assets" },
    // 백업 (2026-10-21): D1·프로젝트 문서·사진 사본 — 사진 버킷과 따로 (src/backup.ts, docs/server/backup.md)
    { "binding": "BACKUP", "bucket_name": "ganpanda-backup" }
  ],
  // 매시간 17분: 백업 (src/backup.ts runBackup)
  "triggers": { "crons": ["17 * * * *"] },
  // 계정·세션·프로젝트·초대 (관계 조회) — 좌석 계산은 Account DO (1-2c)
  "d1_databases": [{ "binding": "DB", "database_name": "ganpanda", "database_id": "071b8dc9-e526-4da1-aabc-f8143771169d", "migrations_dir": "migrations" }],
  // 매직링크 이메일 (도메인 ganpanda.co.kr 을 Email Sending 에 온보딩해야 발송됨)
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // 매직링크가 가리키는 앱 주소
    "APP_URL": "https://ganpanda.co.kr"
  }
}
